# Copy to .env for local dev. On Railway, set the same keys in Variables (never commit .env).

NODE_ENV=development

# MongoDB (use ONE of these names on Railway if you prefer):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority
# MONGODB_URI=
# DATABASE_URL=
# MONGO_URL=

# If your URI looks like …mongodb.net/?appName=… (no database path), Mongoose defaults to DB "test".
# Set this to your real database name (same as in Atlas / where your collections live):
# MONGO_DB_NAME=studtrade

# CORS: exact Vercel origin(s), comma-separated, no trailing slash
# FRONTEND_URL=https://your-app.vercel.app

JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_USER=
EMAIL_PASS=

# Do NOT set PORT on Railway — the platform injects it to match public networking.
