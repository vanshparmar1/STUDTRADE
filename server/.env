# ─── Server Environment ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Client URL (for CORS whitelist) ─────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/studtrade

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
