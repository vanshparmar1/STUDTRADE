# Copy to client/.env for local dev. Set the same keys in Vercel (never commit .env).

# In dev, leave unset — Vite proxy forwards /api → localhost:5000
# VITE_API_URL=https://your-backend.onrender.com

# Must match server ALLOWED_EMAIL_DOMAIN
VITE_ALLOWED_EMAIL_DOMAIN=university.edu

# Contact page (optional)
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_SUPPORT_PHONES=+1 555 000 0000

# Payment mode: "online" (Cashfree) or omit for offline QR flow
# VITE_PAYMENT_MODE=online
# VITE_CASHFREE_APP_ID=

# Offline QR checkout (when VITE_PAYMENT_MODE is not "online")
# VITE_OFFLINE_PAYMENT_QR_SRC=/offline-payment-qr.png
# VITE_OFFLINE_PAYMENT_PHONE=
